# Mainnet end-to-end suite configuration. Copy to e2e/.env (git-ignored). Every value is optional;
# tests that need a missing value are skipped, except that at least one RPC URL is required unless
# E2E_ALLOW_EMPTY=1 acknowledges an all-skipped run.

# Live read-only checks, anvil fork tests and Foundry fork tests. Any Ethereum mainnet JSON-RPC.
ETHEREUM_RPC_URL=
# Starknet mainnet JSON-RPC serving spec 0.9.x or 0.10.x (what starknet.js 10.5 supports).
STARKNET_RPC_URL=
# Optional pinned fork block for anvil and Foundry. Pinning makes fork tests reproducible and lets
# Foundry cache RPC responses. Leave blank to fork the latest block.
ETHEREUM_FORK_BLOCK=

# Optional: verify reviewed mainnet deployments against the pinned constants and source tree.
ETHEREUM_ENTRY_ROUTER=
ETHEREUM_EXIT_SETTLEMENT_FACTORY=
STARKNET_CCTP_EXIT_ANONYMIZER=

# Optional: probe a deployed API (health, config) and use it for the canary.
E2E_API_URL=

# ---------------------------------------------------------------------------------------------
# Real-funds canary. Everything below moves real mainnet assets and is refused unless
# E2E_MAINNET_CANARY is set to the exact arming sentinel. Use a dedicated, capped canary wallet
# funded with only what the run needs. Never a treasury or relayer key.
# ---------------------------------------------------------------------------------------------
E2E_MAINNET_CANARY=
E2E_ETHEREUM_PRIVATE_KEY=
E2E_RECIPIENT=
E2E_INPUT_TOKEN=USDC
E2E_OUTPUT_TOKEN=USDC
E2E_AMOUNT=10
E2E_DELAY_MINUTES=5
# Refuse to start when the quoted bridge amount exceeds this many USDC.
E2E_MAX_BRIDGE_USDC=25
