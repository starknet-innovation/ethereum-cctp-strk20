{
  "name": "@privacy-round-trip/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mainnet end-to-end integration suite: live dependency checks, forked-mainnet EVM round trips, and the gated real-funds canary.",
  "scripts": {
    "test:e2e": "vitest run",
    "test:e2e:live": "vitest run src/preflight.test.ts src/mainnet",
    "test:e2e:fork": "vitest run src/preflight.test.ts src/fork",
    "test:e2e:canary": "vitest run src/canary",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@privacy-round-trip/shared": "0.1.0",
    "starknet": "10.5.0",
    "viem": "^2.37.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "fastify": "^5.6.0",
    "vite": "^7.1.4"
  }
}
