# Mainnet only. Never expose these values through VITE_ variables.
HOST=127.0.0.1
PORT=8787
CORS_ORIGIN=http://localhost:5173
ETHEREUM_RPC_URL=
STARKNET_RPC_URL=
# Operator-issued mainnet key with Starkscan's `prove` scope.
STARKSCAN_API_KEY=
DISCOVERY_URL=
PAYMASTER_URL=
# Server-only AVNU key used for sponsored and sponsored_private Paymaster calls.
AVNU_PAYMASTER_API_KEY=

# Set after reviewed deployments.
ETHEREUM_ENTRY_ROUTER=
ETHEREUM_EXIT_SETTLEMENT_FACTORY=
STARKNET_CCTP_EXIT_ANONYMIZER=

# Relayer private key is optional for read-only development. Use a secret manager in deployment.
ETHEREUM_RELAYER_PRIVATE_KEY=

# Random 32+ byte value used to hash flow write capabilities.
FLOW_TOKEN_SECRET=

# Production uses a TLS-enabled, cluster-aware Valkey endpoint. Leave blank for the in-memory
# development fallback.
STATE_CACHE_ENDPOINT=
STATE_CACHE_PORT=6379
STATE_CACHE_USERNAME=
STATE_CACHE_PASSWORD=

# Conservative advisory estimate used for the route quote. AVNU's actual private fees are checked
# again before each proof; stale final-swap slippage falls back to recoverAsUsdc after one hour.
ESTIMATED_STARKNET_FEES_USDC=2
